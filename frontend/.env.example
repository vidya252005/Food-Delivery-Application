# Copy to frontend/.env and restart `npm start`
#
# Why a frontend .env?
# Create React App runs in the browser. Values like the Google Client ID and API
# URL are baked in at build time from REACT_APP_* variables. They are public
# (visible in the JS bundle) — only put non-secret config here.

# Backend API (optional — defaults to http://localhost:5001/api)
REACT_APP_API_URL=http://localhost:5001/api

# Google Sign-In — public Client ID (same value as backend GOOGLE_CLIENT_ID)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins (add both — CRA may use 3001 if 3000 is busy):
#   http://localhost:3000
#   http://localhost:3001
REACT_APP_GOOGLE_CLIENT_ID=
