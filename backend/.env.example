# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=5001

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=food_delivery
PG_USER=food_delivery_app
PG_PASSWORD=devpassword

# --- Connection pool tuning (see src/config/db.js) ---
PG_POOL_MAX=20
PG_POOL_MIN=2
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000

# --- Auth ---
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google OAuth — required for Google Sign-In (use the same Client ID in frontend/.env)
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:3000
