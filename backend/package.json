    "seed": "node scripts/seed.js",
    "seed:benchmark": "node scripts/seed.js --scale=benchmark",
    "benchmark": "node scripts/benchmark.js",
    "measure-api": "node scripts/measure-api.js",
    "validate-images": "node scripts/validate-food-images.js",
    "loadtest": "node scripts/loadtest.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --runInBand",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:system": "jest tests/system --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [],
